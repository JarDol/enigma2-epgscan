# epgpl - ustawienia (po zmianie nic nie trzeba restartowac, czytane przy kazdym uruchomieniu)
RECEIVER=                      # adres dekodera (OpenWebif) - pyta o niego instalator; zmiana: sudo bash /opt/epgpl/configure.sh
SERVER_IP=                     # adres tego serwera w sieci; puste = wykryj automatycznie
GRAB_TIME=01:15                # godzina codziennego pobierania (kilka: 03:00,15:00); zmiana: sudo bash /opt/epgpl/configure.sh
PORT=8088                      # port serwera HTTP z plikami EPG
DAYS=7                         # ile dni programu pobierac
SITES=teleman,onet,wp,naz      # zrodla programu w kolejnosci pierwszenstwa: teleman, onet, wp (pilot.wp.pl), naz (programtv.naziemna.info), cp (Canal+ - nie dziala)
SCOPE=bouquets                 # bouquets = kanaly z Twoich bukietow (+ wszystkie ich kopie na satelicie), all = wszystko co sie da
COPIES=tp                      # kopie kanalow w mapie: tp = tylko z transponderow z Twoimi kanalami (bez obcych platform), all = wszystkie
SKIP_BOUQUETS="Last Scanned"   # bukiety pomijane przy wyborze kanalow (ale ich referencje trafiaja do mapy)
MAX_CONNECTIONS=2              # rownolegle zapytania NA KAZDY serwis (serwisy pobierane jednoczesnie; przy bledach skrypt zmniejsza)
KEEP_LOGS=7                    # ile logow przechowywac
TUNER_WINDOW=3                 # harmonogram serwera pomijany, gdy dekoder (EPG Scan, opcja pobierania na serwerze) pobiera w oknie +-N h; 0 = nigdy
GRAB_YESTERDAY=1               # pobieraj tez dzien poprzedni (trwajaca noc jest na stronach serwisow pod poprzednim dniem); 0 = nie
GRAB_DELAY=3000                # przerwa [ms] po kazdej stronie na kazdym polaczeniu; 3000 = jak iptv-org (ok. 1 h), 500 = ok. 3 min, ale ryzyko blokad (429); nie mniej niz 300
KANDYDACI=0                         # 1 = po pobieraniu program na dobe dla kandydatow z okna wyboru stacji (EPG Scan); ustawienie z EPG Scan ma pierwszenstwo

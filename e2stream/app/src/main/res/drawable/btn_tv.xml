<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#FF1E88E5" /><corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#FF1565C0" /><corners android:radius="6dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#33FFFFFF" /><corners android:radius="6dp" /></shape>
    </item>
</selector>

msgstr "OK: select a track. Info/EPG: full PAT/PMT and stream details."

msgid "OK: zaznacz / odznacz.  Zielony: zapisz.  Czerwony: anuluj."
msgstr "OK: select / deselect.  Green: save.  Red: cancel."

msgid "OK: zaznacz / odznacz.  Zolty: dodaj wlasny katalog.  Niebieski: usun wlasny.  Zielony: zapisz."
msgstr "OK: select / deselect.  Yellow: add custom directory.  Blue: remove custom directory.  Green: save."

msgid "OK: zaznacz / odznacz. Kanal dostaje dane z pierwszego zrodla, ktore je ma.\n[wlasne] - Twoje listy (zostaja zawsze), [kopia pakietu] - z odinstalowanego pakietu zrodel."
msgstr "OK: select / deselect. A channel uses the first source containing data.\n[custom] - your lists (always retained); [package copy] - from an uninstalled sources package."

msgid "OK: zaznacz.  Zielony: dalej.  Czerwony: anuluj."
msgstr "OK: select.  Green: continue.  Red: cancel."

